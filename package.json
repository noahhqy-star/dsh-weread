{
  "name": "weread",
  "version": "1.0.0",
  "type": "module",
  "description": "微信读书：在 DeepSeek Harness 里扫码登录、浏览书架并在右侧栏阅读，边读边聊。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/rpc.js",
    "lib/weread.js",
    "lib/zlib.js",
    "lib/store.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg",
    "lib/zlib-cli.js",
    "lib/zlib-setup.js"
  ],
  "dependencies": {
    "fflate": "0.8.2",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weread"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahhqy-star/dsh-weread.git"
  },
  "scripts": {
    "test": "node --test"
  }
}
